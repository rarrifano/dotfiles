# ~/.bashrc

case $- in
	*i*) ;;
	*) return ;;
esac

HISTCONTROL=ignoreboth
HISTSIZE=5000
HISTFILESIZE=10000
shopt -s histappend

shopt -s checkwinsize
shopt -s cdspell
shopt -s globstar
set -o vi

export EDITOR=vim
export VISUAL=vim

case ":$PATH:" in
	*:"$HOME/.local/bin":*) ;;
	*) PATH="$HOME/.local/bin:$PATH" ;;
esac

PROMPT_DIRTRIM=3
parse_git_branch() {
	git branch --show-current 2>/dev/null | sed 's/.*/(&)/'
}
PS1='\[\033[01;34m\]\W\[\033[00m\]\[\033[01;33m\]$(parse_git_branch)\[\033[00m\]:\$ '

if command -v dircolors >/dev/null 2>&1; then
	eval "$(dircolors -b)"
fi

alias grep='grep --color=auto'
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lhA'

if [ -f /usr/share/bash-completion/bash_completion ]; then
	. /usr/share/bash-completion/bash_completion
fi
if [ -f ~/.bashrc.local ]; then
	. ~/.bashrc.local
fi
