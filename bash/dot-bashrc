# .bashrc

case $- in
    *i*) ;;
    *) return ;;
esac

# Source global definitions
if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

# User specific environment
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
esac
export PATH

export EDITOR=vim
export VISUAL=vim

alias grep='grep --color=auto'
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lhA'
alias pi-commit='git commit -m "$(pi -p /commit)"'

vgrep() {
    vim -q <(git grep -n --no-color "$@") -c copen
}
