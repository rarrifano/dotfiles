# .bashrc

case $- in
    *i*) ;;
    *) return ;;
esac

if [ -f /etc/bashrc ]; then
    . /etc/bashrc
fi

if [ -f ~/bashrc.local ]; then
    . ~/.bashrc.local
fi

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) PATH="$HOME/.local/bin:$PATH" ;;
esac

PS1='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

export PATH
export EDITOR=vim
export VISUAL=vim

alias grep='grep --color=auto'
alias ls='ls --color=auto'
alias ll='ls -lh'
alias la='ls -lhA'
alias pi-commit='git commit -m "$(pi -p /commit)"'

vgrep() {
    vim -q <(git grep -n --no-color "$@") -c copen
}
