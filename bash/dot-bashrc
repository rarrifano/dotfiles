# ~/.bashrc

case $- in
	*i*) ;;
	*) return ;;
esac

HISTCONTROL=ignoreboth
HISTSIZE=5000
HISTFILESIZE=10000
shopt -s histappend

shopt -s checkwinsize
shopt -s cdspell
set -o vi

export EDITOR=nvim
export VISUAL=nvim

PROMPT_DIRTRIM=3
parse_git_branch() {
	git branch --show-current 2>/dev/null | sed 's/.*/(&)/'
}
PS1='\[\033[01;34m\]\W\[\033[00m\]\[\033[01;33m\]$(parse_git_branch)\[\033[00m\]:\$ '

if command -v dircolors >/dev/null 2>&1; then
	eval "$(dircolors -b)"
fi

alias ..='cd ..'
alias gg='git grep'
alias grep='grep --color=auto'
alias la='ls -A'
alias ll='ls -alF'
alias ls='ls --color=auto'
alias v='$EDITOR'
alias gs='git status -sb'
alias gp='git push'
alias vj='$EDITOR ~/journal.txt'

if [ -f /usr/share/bash-completion/bash_completion ]; then
	. /usr/share/bash-completion/bash_completion
elif [ -f /etc/bash_completion ]; then
	. /etc/bash_completion
fi

if [ -f ~/.bashrc.local ]; then
	. ~/.bashrc.local
fi
