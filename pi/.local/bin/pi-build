#!/usr/bin/env bash
set -euo pipefail

IMAGE="${PI_IMAGE:-pi-agent:latest}"
VERSION="${1:-}"

if [[ -z "${VERSION}" ]]; then
    echo "==> Fetching latest pi version..."
    VERSION="$(curl -fsSL https://registry.npmjs.org/@earendil-works/pi-coding-agent/latest \
        | grep -o '"version":"[^"]*"' | cut -d'"' -f4)"
    echo "==> Latest: ${VERSION}"
fi

BUILD_CTX="$(mktemp -d)"
trap 'rm -rf "${BUILD_CTX}"' EXIT

# Bundle host CA certs if present
mkdir -p "${BUILD_CTX}/ca-certs"
if compgen -G "/usr/local/share/ca-certificates/*.crt" > /dev/null 2>&1; then
    cp /usr/local/share/ca-certificates/*.crt "${BUILD_CTX}/ca-certs/"
    echo "==> Bundling $(ls "${BUILD_CTX}/ca-certs/" | wc -l) host CA cert(s)..."
fi

echo "==> Building ${IMAGE} with pi@${VERSION}..."

cat > "${BUILD_CTX}/Containerfile" <<'EOF'
FROM node:24-bookworm-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Minimal system deps + core CLI tools
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        git \
        unzip \
        jq \
        ripgrep \
        fd-find \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# Host CA certificates
COPY ca-certs/ /usr/local/share/ca-certificates/
RUN if ls /usr/local/share/ca-certificates/*.crt 2>/dev/null | grep -q .; then \
        update-ca-certificates; \
    fi

# pi coding agent
ARG PI_VERSION=0.0.0-unset
RUN npm install -g --ignore-scripts \
        "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force

ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
WORKDIR /workspace
ENTRYPOINT ["pi"]
EOF

podman build \
    --format docker \
    --build-arg "PI_VERSION=${VERSION}" \
    -t "${IMAGE}" \
    -f "${BUILD_CTX}/Containerfile" \
    "${BUILD_CTX}"

echo "==> Done! ${IMAGE} ready (pi@${VERSION})"
