#!/usr/bin/env bash
set -euo pipefail

IMAGE="${PI_IMAGE:-pi-agent:latest}"
AGENT_DIR="${PI_AGENT_DIR:-${HOME}/.config/pi}"
WORK_DIR="${PI_WORKDIR:-$(pwd)}"

# Mounts
MOUNT_ARGS=()

# pi config dir — rw for settings, sessions, etc.
# PI_CODING_AGENT_DIR tells pi where to find its config (overrides default ~/.pi/agent)
if [[ -d "${AGENT_DIR}" ]]; then
    MOUNT_ARGS+=(-v "${AGENT_DIR}:/root/.config/pi:z")
else
    echo "[pi] warn: agent dir not found at ${AGENT_DIR}" >&2
fi

# Git identity
[[ -f "${HOME}/.gitconfig" ]] && \
    MOUNT_ARGS+=(-v "${HOME}/.gitconfig:/root/.gitconfig:z,ro")

# SSH — forward agent socket only (no private key material in the container)
# Mount known_hosts + config read-only for host verification and aliases
SSH_ENV=()
if [[ -S "${SSH_AUTH_SOCK:-}" ]]; then
    MOUNT_ARGS+=(-v "${SSH_AUTH_SOCK}:/tmp/ssh-agent.sock:z")
    SSH_ENV+=(-e "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
fi
[[ -f "${HOME}/.ssh/known_hosts" ]] && \
    MOUNT_ARGS+=(-v "${HOME}/.ssh/known_hosts:/root/.ssh/known_hosts:z,ro")
[[ -f "${HOME}/.ssh/config" ]] && \
    MOUNT_ARGS+=(-v "${HOME}/.ssh/config:/root/.ssh/config:z,ro")

# GPG — forward agent socket only (no private key material in the container)
# Mount public keyring + trustdb read-only for encrypt/verify operations
GPG_AGENT_SOCK="$(gpgconf --list-dirs agent-socket 2>/dev/null || echo "${HOME}/.gnupg/S.gpg-agent")"
if [[ -S "${GPG_AGENT_SOCK}" ]]; then
    MOUNT_ARGS+=(-v "${GPG_AGENT_SOCK}:/root/.gnupg/S.gpg-agent:z")
fi
[[ -f "${HOME}/.gnupg/pubring.kbx" ]] && \
    MOUNT_ARGS+=(-v "${HOME}/.gnupg/pubring.kbx:/root/.gnupg/pubring.kbx:z,ro")
[[ -f "${HOME}/.gnupg/trustdb.gpg" ]] && \
    MOUNT_ARGS+=(-v "${HOME}/.gnupg/trustdb.gpg:/root/.gnupg/trustdb.gpg:z,ro")

# GitHub CLI config — read-only so gh auth works inside the container
[[ -d "${HOME}/.config/gh" ]] && \
    MOUNT_ARGS+=(-v "${HOME}/.config/gh:/root/.config/gh:z,ro")

# Working directory
HOST_DIRNAME="$(basename "${WORK_DIR}")"
MOUNT_ARGS+=(-v "${WORK_DIR}:/root/${HOST_DIRNAME}:z")

# Clipboard
CLIPBOARD_ENV=()
CLIPBOARD_SECURITY_ARGS=()

# X11 socket — used as fallback when Wayland socket is unavailable, and for
# pure X11 hosts. No :z — relabelling a socket file breaks the host-side X server.
if [[ -n "${DISPLAY:-}" ]] && [[ -d "/tmp/.X11-unix" ]]; then
    MOUNT_ARGS+=(-v "/tmp/.X11-unix:/tmp/.X11-unix")
    CLIPBOARD_ENV+=(-e "DISPLAY=${DISPLAY}")
    # Force isWaylandSession()=true so pi routes through wl-paste→xclip rather
    # than the native clipboard module (whose getImageBinary() throws instead of
    # returning null, blocking the xclip fallback entirely).
    CLIPBOARD_ENV+=(-e "XDG_SESSION_TYPE=wayland")
    _XAUTH="${XAUTHORITY:-${HOME}/.Xauthority}"
    if [[ -f "${_XAUTH}" ]]; then
        MOUNT_ARGS+=(-v "${_XAUTH}:/tmp/.Xauthority:z,ro")
        CLIPBOARD_ENV+=(-e "XAUTHORITY=/tmp/.Xauthority")
    fi
    # SELinux: label=disable so container_t can access user_tmp_t socket.
    # --privileged is NOT needed — only the MAC label is relaxed.
    CLIPBOARD_SECURITY_ARGS+=(--security-opt label=disable)
fi

# Wayland socket — mount directly so wl-paste works natively in the container.
# With rootless Podman, uid=0 inside the container maps to the invoking user's
# UID via user namespaces, so the compositor's SO_PEERCRED check passes.
# WAYLAND_DISPLAY may be a bare name (relative to XDG_RUNTIME_DIR) or an
# absolute path — handle both.
if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    if [[ "${WAYLAND_DISPLAY}" = /* ]]; then
        _WAYLAND_SOCK="${WAYLAND_DISPLAY}"
        _WAYLAND_NAME="$(basename "${WAYLAND_DISPLAY}")"
    else
        _WAYLAND_SOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/${WAYLAND_DISPLAY}"
        _WAYLAND_NAME="${WAYLAND_DISPLAY}"
    fi
    if [[ -S "${_WAYLAND_SOCK}" ]]; then
        MOUNT_ARGS+=(-v "${_WAYLAND_SOCK}:/tmp/${_WAYLAND_NAME}")
        CLIPBOARD_ENV+=(-e "WAYLAND_DISPLAY=${_WAYLAND_NAME}")
        CLIPBOARD_ENV+=(-e "XDG_RUNTIME_DIR=/tmp")
        [[ ${#CLIPBOARD_SECURITY_ARGS[@]} -eq 0 ]] && \
            CLIPBOARD_SECURITY_ARGS+=(--security-opt label=disable)
    fi
fi

# TTY detection
TTY_ARGS=(-i)
INTERACTIVE=false
[[ -t 0 && -t 1 ]] && TTY_ARGS=(-it) && INTERACTIVE=true

# Non-interactive parallel runs get ephemeral sessions unless the caller
# already passed a session flag (--session, --no-session, -c, -r).
EXTRA_ARGS=()
if [[ "${INTERACTIVE}" == false ]]; then
    has_session_flag=false
    for arg in "$@"; do
        case "${arg}" in
            --session|--no-session|-c|-r) has_session_flag=true; break ;;
        esac
    done
    [[ "${has_session_flag}" == false ]] && EXTRA_ARGS+=(--no-session)
fi

# Session env — honour caller-supplied override, otherwise let PI_CODING_AGENT_DIR own it
SESSION_ENV=()
[[ -n "${PI_CODING_AGENT_SESSION_DIR:-}" ]] && \
    SESSION_ENV+=(-e "PI_CODING_AGENT_SESSION_DIR=${PI_CODING_AGENT_SESSION_DIR}")

exec podman run --rm "${TTY_ARGS[@]}" \
    "${MOUNT_ARGS[@]+"${MOUNT_ARGS[@]}"}" \
    "${CLIPBOARD_SECURITY_ARGS[@]+${CLIPBOARD_SECURITY_ARGS[@]}}" \
    -e "PI_CODING_AGENT_DIR=/root/.config/pi" \
    -e "VISUAL=vi" \
    -e "EDITOR=vi" \
    -e "TERM=${TERM:-xterm-256color}" \
    -e "COLORTERM=${COLORTERM:-truecolor}" \
    "${CLIPBOARD_ENV[@]+${CLIPBOARD_ENV[@]}}" \
    "${SSH_ENV[@]+${SSH_ENV[@]}}" \
    "${SESSION_ENV[@]+${SESSION_ENV[@]}}" \
    --workdir "/root/${HOST_DIRNAME}" \
    "${IMAGE}" \
    "${EXTRA_ARGS[@]+${EXTRA_ARGS[@]}}" \
    "$@"
