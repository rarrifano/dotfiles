let mapleader = " "

syntax on
filetype plugin indent on
set background=dark
silent! colorscheme retrobox

set number
set relativenumber
set ruler
set laststatus=2
set scrolloff=1
set sidescroll=1
set sidescrolloff=2
set display+=lastline
set listchars=tab:>\ ,trail:-,extends:>,precedes:<,nbsp:+
set splitbelow
set splitright

set tabstop=4
set shiftwidth=4
set expandtab
set smarttab
set formatoptions+=j

set ignorecase
set smartcase
set incsearch

set autoread
set backspace=indent,eol,start
set complete-=i
set nrformats-=octal
set history=1000
set tabpagemax=50
set sessionoptions-=options
set viewoptions-=options

set undofile
if !isdirectory(expand("~/.vim/swap"))
  call mkdir(expand("~/.vim/swap"), "p")
endif
if !isdirectory(expand("~/.vim/undo"))
  call mkdir(expand("~/.vim/undo"), "p")
endif
set directory=~/.vim/swap//
set undodir=~/.vim/undo//

augroup vimrc
  autocmd!
  autocmd FileType yaml setlocal tabstop=2 shiftwidth=2 expandtab
  autocmd FileType terraform,hcl setlocal tabstop=2 shiftwidth=2 expandtab
augroup END

set path+=**
set wildmenu
set wildmode=longest:full,full
set wildignore+=*/.git/*

if executable('rg')
  set grepprg=rg\ --vimgrep\ --smart-case
  set grepformat=%f:%l:%c:%m
endif

if executable('fdfind')
  function! FdFindFunc(cmdarg, cmdcomplete)
    return systemlist('fdfind --type f --hidden --exclude .git --glob ' . shellescape(a:cmdarg . '*'))
  endfunction
  set findfunc=FdFindFunc
endif

cnoreabbrev <expr> grep (getcmdtype() ==# ':' && getcmdline() ==# 'grep') ? 'silent grep' : 'grep'
augroup vimrc
  autocmd QuickFixCmdPost grep redraw! | cwindow
augroup END

nnoremap <leader>f :find<space>
nnoremap <leader>g :silent grep<space>
nnoremap ]q :cnext<CR>
nnoremap [q :cprev<CR>
nnoremap ]b :bnext<CR>
nnoremap [b :bprev<CR>
