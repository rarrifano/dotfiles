" ~/.vimrc

syntax on
filetype plugin indent on
colorscheme retrobox

let mapleader=" "
set nocompatible
set encoding=utf-8
set updatetime=100

set tabstop=4
set shiftwidth=4
set softtabstop=4
set expandtab
set autoindent
set smartindent

set incsearch
set hlsearch
set ignorecase
set smartcase

set number
set relativenumber
set nowrap
set scrolloff=4
set showcmd
set wildmenu
set splitbelow
set splitright
set path+=**

set backspace=indent,eol,start
set hidden
set mouse=a

set backupdir=~/.vim/backup//
set directory=~/.vim/swap//
set undodir=~/.vim/undo//
set undofile

nnoremap ]q :cnext<CR>
nnoremap [q :cprevious<CR>
nnoremap ]b :bnext<CR>
nnoremap [b :bprevious<CR>

nnoremap <leader>y "+y
vnoremap <leader>y "+y
nnoremap <leader>f :fin *
