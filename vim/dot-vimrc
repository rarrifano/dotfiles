let mapleader = " "

syntax on
filetype plugin indent on
set background=dark
silent! colorscheme retrobox

set number
set relativenumber
set ruler
set laststatus=2
set scrolloff=1
set sidescroll=1
set sidescrolloff=2
set display+=lastline
set splitbelow
set splitright

set tabstop=4
set shiftwidth=4
set expandtab
set smarttab
set formatoptions+=j

set ignorecase
set smartcase
set incsearch

set autoread
set updatetime=100
set backspace=indent,eol,start
set complete-=i
set nrformats-=octal
set history=1000
set tabpagemax=50
set sessionoptions-=options
set viewoptions-=options

set undofile
if !isdirectory(expand("~/.vim/swap"))
  call mkdir(expand("~/.vim/swap"), "p")
endif
if !isdirectory(expand("~/.vim/undo"))
  call mkdir(expand("~/.vim/undo"), "p")
endif
set directory=~/.vim/swap//
set undodir=~/.vim/undo//

augroup vimrc
  autocmd!
  autocmd FileType yaml setlocal tabstop=2 shiftwidth=2 expandtab
  autocmd FileType terraform,hcl setlocal tabstop=2 shiftwidth=2 expandtab
augroup END

set path+=**
set wildmenu
set wildmode=longest:full,full
set wildignore+=*/.git/*

let g:fzf_colors = {
  \ 'fg':      ['fg', 'Normal'],
  \ 'bg':      ['bg', 'Normal'],
  \ 'hl':      ['fg', 'Comment'],
  \ 'fg+':     ['fg', 'CursorLine', 'CursorColumn', 'Normal'],
  \ 'bg+':     ['bg', 'CursorLine', 'CursorColumn'],
  \ 'hl+':     ['fg', 'Statement'],
  \ 'info':    ['fg', 'PreProc'],
  \ 'border':  ['fg', 'Ignore'],
  \ 'prompt':  ['fg', 'Conditional'],
  \ 'pointer': ['fg', 'Exception'],
  \ 'marker':  ['fg', 'Keyword'],
  \ 'spinner': ['fg', 'Label'],
  \ 'header':  ['fg', 'Comment'] }

nnoremap <leader>y "+y
vnoremap <leader>y "+y
nnoremap <leader>f :FZF<CR>
nnoremap <leader>g :Rg<SPACE>
nnoremap ]q :cnext<CR>
nnoremap [q :cprev<CR>
nnoremap ]b :bnext<CR>
nnoremap [b :bprev<CR>
